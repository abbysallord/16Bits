# Server Port (Render/Railway set PORT automatically)
PORT=8000

# Database. Leave empty to use a local SQLite file (backend/data/omniops.sqlite).
# Set to a Postgres URL (e.g. Neon: postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require)
# so incidents, approvals and users survive restarts. Tables are created automatically on boot.
DATABASE_URL=

# Authentication secret - REQUIRED. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# AI engine: groq (default, free tier) or gemini. The other is used as fallback if its key is set.
AI_PROVIDER=groq

# Groq (free key: https://console.groq.com/keys). OpenAI's open-weight model on Groq:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (optional, free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Max output tokens per agent call
AI_MAX_TOKENS=2048

# Optional: if set, POST /api/agents/webhook/alert requires header x-webhook-secret
WEBHOOK_SECRET=

# Optional: LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=16bits-omniops

# Optional: Slack webhook notification URL
SLACK_WEBHOOK_URL=

# CORS allowlist (comma-separated). Defaults to the Vercel app + localhost:5173/4173 when unset.
# CORS_ORIGINS=https://16bits-omniops.vercel.app,http://localhost:5173
