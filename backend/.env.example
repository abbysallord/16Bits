# Server Port (Render/Railway set PORT automatically)
PORT=8000

# Database. Leave empty to use a local SQLite file (backend/data/omniops.sqlite).
# Set to a Postgres URL (e.g. Neon: postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require)
# so incidents, approvals and users survive restarts. Tables are created automatically on boot.
DATABASE_URL=

# Authentication secret - REQUIRED. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# AI engine: groq (default, free tier) or gemini. The other is used as fallback if its key is set.
AI_PROVIDER=groq

# Groq (free key: https://console.groq.com/keys). OpenAI's open-weight model on Groq:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (optional, free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# The Gemini key also enables embedding-based runbook search (gemini-embedding-001)
# RUNBOOK_EMBEDDINGS=off
# LLM picks the best of the top 3 runbook matches, or none. Set off to skip that extra call
# RUNBOOK_RERANK=off

# Max output tokens per agent call
AI_MAX_TOKENS=2048

# Optional: if set, POST /api/agents/webhook/alert requires header x-webhook-secret
WEBHOOK_SECRET=

# Optional: LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=16bits-omniops

# Optional: Slack incoming webhook. Posts each triaged incident with a Review & approve link, plus approvals
SLACK_WEBHOOK_URL=
# Web console URL used for links in Slack messages
APP_URL=https://16bits-omniops.vercel.app

# CORS allowlist (comma-separated). Defaults to the Vercel app + localhost:5173/4173 when unset.
# CORS_ORIGINS=https://16bits-omniops.vercel.app,http://localhost:5173

# Public demo login (admin@16bits.io / admin123). Set off for a real deployment
DEMO_ACCOUNT=on

# Rate limiting (per client IP, in memory). RATE_LIMIT=off disables it; per-bucket overrides:
# RATE_LIMIT_LOGIN=10 RATE_LIMIT_REGISTER=20 RATE_LIMIT_EXECUTE=60 RATE_LIMIT_WEBHOOK=120 RATE_LIMIT_APPROVE=30
# Proxy hops in front of the app (Render = 1) so the real client IP is used
# TRUST_PROXY_HOPS=1
